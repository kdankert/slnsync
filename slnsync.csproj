<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>slnsync</PackageId>
        <Version>0.0.0</Version>
        <Description>Keeps an aggregate solution in sync with source .sln/.slnx solutions.</Description>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>slnsync</ToolCommandName>
        <PackageOutputPath>$(MSBuildProjectDirectory)/nupkg</PackageOutputPath>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
        <None Include="LICENSE" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Xml" Version="11.0.0"/>
        <PackageReference Include="System.CommandLine" Version="3.0.0"/>
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52"/>
        <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
